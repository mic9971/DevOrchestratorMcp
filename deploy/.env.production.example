# Immutable image produced by release-image.yml
DEVORCHESTRATOR_IMAGE=ghcr.io/mic9971/devorchestratormcp:sha-REPLACE_ME
DEVORCHESTRATOR_PORT=5058
DEVORCHESTRATOR_ALLOWED_HOSTS=orchestrator.example.com

# Managed PostgreSQL. Use SSL/TLS settings appropriate for the provider.
DEVORCHESTRATOR_DATABASE_URL=Host=db.example.com;Port=5432;Database=devorchestrator;Username=devorchestrator;Password=REPLACE_ME;SSL Mode=Require

# MCP role credentials: minimum 24 chars, distinct. Previous values are optional rotation overlap.
DEVORCHESTRATOR_ARCHITECT_KEY=REPLACE_WITH_STRONG_SECRET
DEVORCHESTRATOR_ARCHITECT_PREVIOUS_KEY=
DEVORCHESTRATOR_IMPLEMENTER_KEY=REPLACE_WITH_STRONG_SECRET
DEVORCHESTRATOR_IMPLEMENTER_PREVIOUS_KEY=
DEVORCHESTRATOR_AUDITOR_KEY=REPLACE_WITH_STRONG_SECRET
DEVORCHESTRATOR_AUDITOR_PREVIOUS_KEY=

# Prefer GitHub App in production. GITHUB_TOKEN is a fallback only.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PEM=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_STRONG_SECRET

# Optional OTLP collector, e.g. https://otel-collector.example.com:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
